# Build products
*.so
*.o
*.gcno
*.gcda
.rounding_probe
.mxcsr_probe
.abs-build-manifest.json
.abs-build-manifest.json.tmp.*
.cfg/

# CMake build trees.  The pattern is deliberately broad: a configured tree is
# a few hundred files and belongs to whoever configured it, not to the
# repository.
build/
build-*/
_prefix/
CMakeUserPresets.json

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Manuscript build artifact (built by build_paper.sh, produced in CI)
paper.pdf
