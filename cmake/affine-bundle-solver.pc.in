# Relocatable on purpose: the prefix is derived from where this file actually
# sits, not from CMAKE_INSTALL_PREFIX at configure time.  Otherwise
# `cmake --install --prefix <somewhere-else>` writes a .pc that points at the
# configure-time prefix and silently sends the consumer to the wrong headers.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: affine-bundle-solver
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lcertified_solver -lstatus_verifier -laffine_bundle_solver
Cflags: -I${includedir}
